### Defensive settings for make:
#     https://tech.davis-hansson.com/p/make/
SHELL:=bash
.ONESHELL:
.SHELLFLAGS:=-eu -o pipefail -O inherit_errexit -c
.SILENT:
.DELETE_ON_ERROR:
MAKEFLAGS+=--warn-undefined-variables
MAKEFLAGS+=--no-builtin-rules

# We like colors
# From: https://coderwall.com/p/izxssa/colored-makefile-for-golang-projects
RED=`tput setaf 1`
GREEN=`tput setaf 2`
RESET=`tput sgr0`
YELLOW=`tput setaf 3`

# Python checks
UV?=uv

# installed?
ifeq (, $(shell which $(UV) ))
  $(error "UV=$(UV) not found in $(PATH)")
endif

PROJECT_FOLDER=$(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))

PLONE_VERSION?=6.2-dev
PYTHON_VERSION?=3.12

ifdef CI
UV_VENV_ARGS :=
else
UV_VENV_ARGS := --python=$(PYTHON_VERSION)
endif

VENV_FOLDER=$(PROJECT_FOLDER)/.venv
export VIRTUAL_ENV=$(VENV_FOLDER)
BIN_FOLDER=$(VENV_FOLDER)/bin

# The QA targets run the tox environments generated by plone/meta, so they use
# the same tools and versions as CI.
TOX=$(UV)x --with tox-uv tox

# A PYTHONPATH from the calling shell (an editor's .env file, say) would put
# other packages before those of tox, uv and the venv.
unexport PYTHONPATH

# Environment variables to be exported
export PYTHONWARNINGS := ignore
# Don't let the env-var bootstrap initialize Sentry during tests.
export SENTRY_DISABLE := 1

all: install

# Add the following 'help' target to your Makefile
# And add help text after each target name starting with '\#\#'
.PHONY: help
help: ## This help message
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}'

$(VENV_FOLDER): setup.py ## Install the package with its test dependencies
	@echo "$(GREEN)==> Install environment$(RESET)"
	@if [[ -d "$(VENV_FOLDER)" ]]; then echo "$(YELLOW)==> Environment already exists at $(VENV_FOLDER)$(RESET)"; else $(UV) venv $(UV_VENV_ARGS) $(VENV_FOLDER); fi
	@$(UV) pip install -c https://dist.plone.org/release/$(PLONE_VERSION)/constraints.txt -e ".[test]" zope.testrunner
	@touch $(VENV_FOLDER)

.PHONY: install
install: $(VENV_FOLDER) ## Install the package with its test dependencies

.PHONY: clean
clean: ## Remove the environment, tox environments and build output
	@echo "$(RED)==> Cleaning environment and build$(RESET)"
	@rm -rf $(VENV_FOLDER) .tox build dist src/*.egg-info .coverage coverage.xml htmlcov forest.json forest.dot

# QA
.PHONY: lint
lint: ## Check the code base according to Plone standards (tox -e lint)
	@echo "$(GREEN)==> Lint codebase$(RESET)"
	@$(TOX) -e lint

.PHONY: format
format: ## Fix the code base according to Plone standards (tox -e format)
	@echo "$(GREEN)==> Format codebase$(RESET)"
	@$(TOX) -e format

.PHONY: check
check: format lint ## Fix and check the code base according to Plone standards

.PHONY: dependencies
dependencies: ## Check that all dependencies are declared (tox -e dependencies)
	@echo "$(GREEN)==> Check dependencies$(RESET)"
	@$(TOX) -e dependencies

.PHONY: circular
circular: ## Check for circular dependencies (tox -e circular)
	@echo "$(GREEN)==> Check circular dependencies$(RESET)"
	@$(TOX) -e circular

# tox -e release-check runs 'towncrier build --yes', which rewrites CHANGES.rst
# and deletes the news fragments, so it runs on a copy of the tracked and new,
# not ignored, files. The copy's folder must have the package name.
RELEASE_CHECK_COPY=$(PROJECT_FOLDER)/.tox/release-check-copy/collective.sentry

.PHONY: release-check
release-check: ## Check that the package is ready for release, on a copy of the checkout
	@echo "$(GREEN)==> Check release$(RESET)"
	@mkdir -p $(RELEASE_CHECK_COPY) && \
		git ls-files --cached --others --exclude-standard \
			| while read -r f; do if [[ -e "$$f" ]]; then echo "$$f"; fi; done \
			| tar -cf - -T - | tar -xf - -C $(RELEASE_CHECK_COPY) && \
		cd $(RELEASE_CHECK_COPY) && \
		$(TOX) -e release-check

.PHONY: qa
qa: lint dependencies circular release-check ## Run all checks CI runs, without changing files

# Tests
.PHONY: test
test: $(VENV_FOLDER) ## Run the tests in the local environment
	@$(BIN_FOLDER)/zope-testrunner --all --test-path=$(PROJECT_FOLDER)/src -s collective.sentry

.PHONY: test-zope
test-zope: ## Run the unit tests against plain Zope, without Plone (tox -e zope)
	@$(TOX) -e zope

.PHONY: test-all
test-all: ## Run the tests on all supported Python versions (tox)
	@$(TOX) -e $$($(TOX) list --no-desc | grep -E '^py[0-9]+-plone' | paste -sd, -),zope

.PHONY: test-coverage
test-coverage: ## Run the tests with coverage (tox -e coverage)
	@$(TOX) -e coverage

.PHONY: release
release: ## Create a release
	@echo "$(GREEN)==> Create a release$(RESET)"
	@$(UV)x --from zest.releaser --with zestreleaser.towncrier fullrelease
